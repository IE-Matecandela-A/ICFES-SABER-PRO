    <div id="yt-modal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/90 backdrop-blur-sm" onclick="closeYTModal()">
        <div class="relative w-full max-w-4xl mx-4 aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/10 flex items-center justify-center" onclick="event.stopPropagation()">
            
            <!-- Mensaje de respaldo por si YouTube bloquea el iframe en local -->
            <div id="yt-fallback-msg" class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center bg-slate-900 hidden z-0">
                <span class="material-icons-round text-red-500 text-6xl mb-4">error_outline</span>
                <h3 class="text-xl font-bold text-white mb-2">Restricción de YouTube (Error 153)</h3>
                <p class="text-slate-300 max-w-md mb-6">Parece que estás abriendo la aplicación localmente (file://). Por seguridad, YouTube bloquea los reproductores integrados que no provienen de un servidor web.</p>
                <a id="yt-fallback-link" href="#" target="_blank" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl font-bold transition-colors flex items-center gap-2">
                    <span class="material-icons-round">open_in_new</span> Ver en YouTube
                </a>
            </div>

            <button class="absolute -top-12 right-0 md:top-4 md:-right-16 z-20 w-10 h-10 flex items-center justify-center bg-white/10 hover:bg-white/20 rounded-full text-white transition-colors" onclick="closeYTModal()">
                <span class="material-icons-round">close</span>
            </button>
            <iframe id="yt-iframe" class="w-full h-full relative z-10" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </div>
    
    <script>
        function openYTModal(event, url) {
            event.preventDefault();
            const videoIdMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/);
            if(videoIdMatch && videoIdMatch[1]) {
                const videoId = videoIdMatch[1];
                
                const isLocalFile = window.location.protocol === 'file:';
                const iframe = document.getElementById('yt-iframe');
                const fallback = document.getElementById('yt-fallback-msg');
                const fallbackLink = document.getElementById('yt-fallback-link');

                if (isLocalFile) {
                    // En local (file://), YouTube bloquea el iframe (Error 153).
                    // Ocultamos el iframe y mostramos nuestro mensaje de respaldo.
                    iframe.classList.add('hidden');
                    fallback.classList.remove('hidden');
                    fallback.classList.add('z-20');
                    fallbackLink.href = url;
                } else {
                    iframe.classList.remove('hidden');
                    fallback.classList.add('hidden');
                    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
                }

                const modal = document.getElementById('yt-modal');
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden'; 
            } else {
                window.open(url, '_blank');
            }
        }

        function closeYTModal() {
            const modal = document.getElementById('yt-modal');
            modal.classList.add('hidden');
            document.getElementById('yt-iframe').src = '';
            document.body.style.overflow = '';
            document.getElementById('yt-fallback-msg').classList.add('hidden');
            document.getElementById('yt-iframe').classList.remove('hidden');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const videoCards = document.querySelectorAll('.video-card-premium');
            videoCards.forEach(card => {
                const href = card.getAttribute('href');
                if(href && (href.includes('youtube.com') || href.includes('youtu.be'))) {
                    card.addEventListener('click', (e) => openYTModal(e, href));
                }
            });
        });
    </script>

    <!-- SERVICE WORKER (uso sin conexión) -->
    <script>
        // El service worker solo funciona si la página se sirve por http/https
        // (no en file://). Si no, simplemente no se registra y no pasa nada.
        if (location.protocol.startsWith('http')) {
            // El manifest solo se carga si la página está servida por http/https.
            // En file:// el navegador lo bloquea por CORS, así que lo evitamos.
            var mf = document.createElement('link');
            mf.rel = 'manifest';
            mf.href = 'manifest.json';
            document.head.appendChild(mf);

            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('sw.js').catch(function () { /* sin conexión / no disponible */ });
                });
            }
        }
    </script>
