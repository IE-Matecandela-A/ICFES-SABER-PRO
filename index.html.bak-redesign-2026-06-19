        // Modo depuración: agrega "?debug=1" a la URL (o pon window.DEBUG = true) para ver
        // los mensajes internos. En uso normal se silencian los console.log/debug;
        // los avisos (warn) y errores (error) siempre se muestran.
        window.DEBUG = /[?&]debug=1/.test(location.search);
        if (!window.DEBUG) {
            console.log = function () {};
            console.debug = function () {};
        }
